# Stage 1: Build
FROM node:20-slim AS builder

WORKDIR /app

# Cache bust: change this date to force full rebuild when needed
ARG CACHEBUST=20260305
RUN echo "Build $CACHEBUST"

# Копируем файлы зависимостей
COPY package.json yarn.lock* ./

# Устанавливаем зависимости
RUN yarn install --frozen-lockfile

# Копируем исходники
COPY . .

# Создаем пустую media директорию
RUN mkdir -p /app/public/media && touch /app/public/media/.gitkeep

# Аргумент для бэкенд URL (вшивается в билд React)
ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

# Собираем приложение
RUN yarn build

# Stage 2: Production
FROM nginx:alpine

# Копируем собранные файлы из builder
COPY --from=builder /app/build /usr/share/nginx/html

# Копируем конфигурацию nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Создаем media директорию
RUN mkdir -p /usr/share/nginx/html/media

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
