FROM python:3.11-slim

WORKDIR /app

# Устанавливаем MongoDB tools (если реально нужны)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    wget \
  && wget -q https://fastdl.mongodb.org/tools/db/mongodb-database-tools-debian92-x86_64-100.9.4.deb \
  && dpkg -i mongodb-database-tools-debian92-x86_64-100.9.4.deb || true \
  && apt-get install -f -y \
  && rm mongodb-database-tools-debian92-x86_64-100.9.4.deb \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt && \
    pip install --no-cache-dir gunicorn

COPY . /app

EXPOSE 8001

CMD ["gunicorn", "server:app", "--workers", "4", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8001"]