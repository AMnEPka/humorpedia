# Скопируйте в .env (в корне репозитория) — docker compose подхватит автоматически.
# Сгенерировать секрет: python -c "import secrets; print(secrets.token_hex(32))"

# ─── Обязательно для прода (docker-compose-cloud.yml) ───────────────────────
JWT_SECRET=
MONGO_INITDB_ROOT_USERNAME=humorpedia
MONGO_INITDB_ROOT_PASSWORD=
# Первый администратор создаётся при старте, если в БД нет ни одного admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# ─── Прочее ─────────────────────────────────────────────────────────────────
DB_NAME=humorpedia
# Список origin'ов фронтенда через запятую (в проде не оставлять *)
CORS_ORIGINS=*
# URL бэкенда, вшивается в сборку фронтенда
REACT_APP_BACKEND_URL=http://localhost:8001

# OAuth (необязательно)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=
